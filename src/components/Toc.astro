---
// Table des matières imbriquée, comme `tableOfContents` de gatsby-transformer-remark.
import type { MarkdownHeading } from 'astro'

type Node = { heading: MarkdownHeading; children: Node[] }

const { headings } = Astro.props as { headings: MarkdownHeading[] }

const root: Node[] = []
const stack: Node[] = []
for (const heading of headings.filter((h) => h.slug !== 'footnote-label')) {
  const node: Node = { heading, children: [] }
  while (stack.length && stack[stack.length - 1].heading.depth >= heading.depth) stack.pop()
  ;(stack.length ? stack[stack.length - 1].children : root).push(node)
  stack.push(node)
}

const escape = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')

const renderList = (nodes: Node[]): string =>
  `<ul>${nodes
    .map(
      ({ heading, children }) =>
        `<li><a href="#${escape(heading.slug)}">${escape(heading.text)}</a>${
          children.length ? renderList(children) : ''
        }</li>`,
    )
    .join('')}</ul>`
---
{root.length > 0 && <nav set:html={renderList(root)} />}
